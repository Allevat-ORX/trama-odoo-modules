<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mass send wizard form -->
    <record id="wa_mass_send_wizard_form" model="ir.ui.view">
        <field name="name">wa.mass.send.wizard.form</field>
        <field name="model">wa.mass.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar WhatsApp masivo">
                <group>
                    <field name="applicant_ids" invisible="1"/>
                    <field name="applicant_count" readonly="1" string="Candidatos"/>
                    <field name="wasender_config_id" options="{'no_create': True}"/>
                    <field name="template_id" options="{'no_create': True}"/>
                    <field name="message" placeholder="Escribe tu mensaje aqui. Usa {nombre}, {puesto} y {link_portal} como variables."/>
                </group>
                <footer>
                    <button string="Enviar a todos" name="action_send" type="object" class="btn-success" icon="fa-whatsapp"
                            confirm="Se enviara WhatsApp a todos los candidatos seleccionados. Continuar?"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action: appears in list view Action menu -->
    <record id="action_wa_mass_send" model="ir.actions.server">
        <field name="name">Enviar WhatsApp masivo</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = {
        "name": "Enviar WhatsApp masivo",
        "type": "ir.actions.act_window",
        "res_model": "wa.mass.send.wizard",
        "view_mode": "form",
        "target": "new",
        "context": {
            "default_applicant_ids": records.ids,
        },
    }
        </field>
    </record>
</odoo>
