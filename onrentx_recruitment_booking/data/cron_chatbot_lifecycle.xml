<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Chatbot Lifecycle Cron
        Sends reminders and auto-closes stale WA conversations.
        Runs every 6 hours. Excludes Deserto/Rechazado/archived candidates.
        Phase 10 fix: added excluded_stages filter + opted_out check.
    -->
    <record id="cron_chatbot_lifecycle" model="ir.cron">
        <field name="name">Chatbot WA Lifecycle (reminders + auto-close)</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">model._cron_chatbot_lifecycle()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
