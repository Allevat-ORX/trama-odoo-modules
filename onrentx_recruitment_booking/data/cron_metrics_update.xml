<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Cron job for daily metrics computation -->
    <record id="recruitment_metrics_cron" model="ir.cron">
        <field name="name">Recruitment: Compute Daily Metrics</field>
        <field name="model_id" ref="model_recruitment_metrics"/>
        <field name="state">code</field>
        <field name="code">model.compute_daily_metrics()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-03-30 12:00:00</field>
    </record>

    <!-- Alternative: Run at 6:00 AM daily -->
    <record id="recruitment_metrics_cron_morning" model="ir.cron">
        <field name="name">Recruitment: Compute Daily Metrics (6AM)</field>
        <field name="model_id" ref="model_recruitment_metrics"/>
        <field name="state">code</field>
        <field name="code">model.compute_daily_metrics()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-03-30 11:00:00</field>
        <field name="active">True</field>
    </record>
</odoo>
