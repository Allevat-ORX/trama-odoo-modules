<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add JCF Vinculacion tab to applicant form -->
    <record id="view_hr_applicant_jcf_vinculacion" model="ir.ui.view">
        <field name="name">hr.applicant.jcf.vinculacion</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='interview_page']" position="after">
                <page string="Vinculacion JCF" name="jcf_vinculacion_tab">
                    <group>
                        <group string="Estado Vinculacion">
                            <field name="jcf_vinculacion_nivel" widget="radio"/>
                            <field name="jcf_vinculacion_orden"/>
                            <field name="jcf_empresa" readonly="0"/>
                            <field name="jcf_vinculado" widget="boolean_toggle"/>
                            <field name="jcf_vinculacion_aviso_enviado" readonly="1"/>
                            <field name="jcf_vinculacion_foto_recibida" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <div class="oe_button_box">
                            <button name="action_send_jcf_vinculacion_wa"
                                    string="Enviar Aviso JCF"
                                    type="object"
                                    class="btn-primary"
                                    invisible="jcf_vinculado == True"/>
                            <button name="action_confirm_jcf_vinculacion"
                                    string="Confirmar Vinculacion"
                                    type="object"
                                    class="btn-success"
                                    invisible="jcf_vinculacion_foto_recibida == False or jcf_vinculado == True"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Wizard for mass JCF vinculacion -->
    <record id="view_jcf_vinculacion_wizard" model="ir.ui.view">
        <field name="name">jcf.vinculacion.wizard.form</field>
        <field name="model">jcf.vinculacion.wizard</field>
        <field name="arch" type="xml">
            <form string="Panel Vinculacion JCF">
                <header>
                    <button name="action_send_n1" string="Enviar a N1 Primarios"
                            type="object" class="btn-primary"/>
                    <button name="action_activate_monitor" string="Activar Monitoreo Auto"
                            type="object" class="btn-warning"/>
                    <button name="action_deactivate_monitor" string="Pausar Monitoreo"
                            type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Panel de Vinculacion JCF - 31 Marzo / 1 Abril</h1>
                    </div>
                    <group>
                        <field name="status_html" widget="html" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_jcf_vinculacion_wizard" model="ir.actions.act_window">
        <field name="name">Panel Vinculacion JCF</field>
        <field name="res_model">jcf.vinculacion.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item under Recruitment -->
    <menuitem id="menu_jcf_vinculacion"
              name="Vinculacion JCF"
              parent="hr_recruitment.menu_hr_recruitment_root"
              action="action_jcf_vinculacion_wizard"
              sequence="100"/>
</odoo>
